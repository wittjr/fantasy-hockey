# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# claude / gsd (machine-local or regenerated by the installer)
.claude/settings.local.json
.claude/.gsd-source
.claude/gsd-core/
.claude/gsd-install-state.json
.claude/gsd-file-manifest.json
.claude/.gsd-profile
.claude/.gsd-surface.json
.claude/agents/
.claude/commands/
.claude/hooks/
.claude/scripts/
.claude/gsd-local-patches/
