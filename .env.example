# Neon Postgres connection string (pooled connection recommended)
# https://neon.tech -> your project -> Connection Details
DATABASE_URL=

# Discord OAuth app: https://discord.com/developers/applications -> New Application -> OAuth2
# Redirect URI to register there: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Auth.js session encryption secret. Generate with: openssl rand -base64 33
AUTH_SECRET=

# Yahoo Fantasy app (https://developer.yahoo.com/apps/) - public client, so no secret.
# Used only for the "Connect Yahoo" league-import flow; Discord remains the app login.
# Redirect URI to register on the Yahoo app: https://<your-domain>/api/yahoo/callback
YAHOO_CLIENT_ID=
# Optional: override the redirect URI (Yahoo rejects http://localhost - use an HTTPS tunnel for local dev)
YAHOO_REDIRECT_URI=
